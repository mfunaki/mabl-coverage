{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": [
    "javascript",
    "typescript",
    "typescriptreact"
  ],
  "google.gemini.mcpServers": {
    "mabl": {
      "command": "npx",
      "args": [
